---
import { CLS } from '../../scripts/jwt/jwt-ui.ts';
---

<!-- Encoder panel. Every id here is read by src/scripts/jwt/. -->
<section id="viewEncode" class="hidden" role="tabpanel" aria-labelledby="tabEncode">
  <div class={CLS.card}>
    <div class={CLS.toolbar}>
      <p class={CLS.hintInline}>Fill in a header and payload, choose an algorithm and key, then sign.</p>
      <div class={CLS.spacer}></div>
      <button class={`${CLS.btnGhost} ${CLS.btnSm}`} id="btnEncExample">Load example</button>
    </div>
    <div class={CLS.stack}>
      <div>
        <label class={CLS.fieldLabel} for="encHeader">Header: Algorithm &amp; Token Type</label>
        <textarea
          id="encHeader"
          class={CLS.field + ' min-h-[150px]'}
          spellcheck="false"
          aria-describedby="encHeaderError">&#123;
  "alg": "HS256",
  "typ": "JWT"
&#125;</textarea>
        <p id="encHeaderError" class={CLS.err} role="status"></p>
      </div>
      <div>
        <label class={CLS.fieldLabel} for="encPayload">Payload: Data</label>
        <textarea
          id="encPayload"
          class={CLS.field + ' min-h-[150px]'}
          spellcheck="false"
          aria-describedby="encPayloadError">&#123;
  "sub": "1234567890",
  "name": "John Doe",
  "admin": true,
  "iat": 1516239022
&#125;</textarea>
        <p id="encPayloadError" class={CLS.err} role="status"></p>
      </div>
    </div>
  </div>

  <div class={CLS.card}>
    <h2 class={CLS.cardHead}>Signing Key</h2>
    <div class="flex flex-wrap items-start gap-3.5">
      <div class="min-w-[180px] flex-[0_1_200px]">
        <label class={CLS.fieldLabel} for="encAlg">Algorithm</label>
        <select id="encAlg" class={CLS.select}>
          <optgroup label="HMAC (secret)">
            <option value="HS256" selected>HS256</option>
            <option value="HS384">HS384</option>
            <option value="HS512">HS512</option>
          </optgroup>
          <optgroup label="RSA (PEM key)">
            <option value="RS256">RS256</option>
            <option value="RS384">RS384</option>
            <option value="RS512">RS512</option>
            <option value="PS256">PS256</option>
            <option value="PS384">PS384</option>
            <option value="PS512">PS512</option>
          </optgroup>
          <optgroup label="ECDSA (PEM key)">
            <option value="ES256">ES256</option>
            <option value="ES384">ES384</option>
            <option value="ES512">ES512</option>
          </optgroup>
          <optgroup label="Unsigned">
            <option value="none">none</option>
          </optgroup>
        </select>
      </div>
      <div class="min-w-[260px] flex-[3_1_420px]">
        <label class={CLS.fieldLabel} id="encKeyLabel" for="encKey">Secret (base64url or raw text)</label>
        <textarea id="encKey" class={CLS.field + ' min-h-[110px]'} spellcheck="false"
          >a-string-secret-at-least-256-bits-long</textarea>
        <div class={CLS.genrow}>
          <button class={`${CLS.btnGhost} ${CLS.btnSm} hidden`} id="btnGenKeys">
            Generate RSA / EC key pair
          </button>
          <span class={CLS.kv + ' ml-auto'} id="encKeyState"></span>
        </div>
        <div id="pubKeyWrap" class="mt-3 hidden">
          <label class={CLS.fieldLabel} for="encPubKey">
            Public Key (PEM) — paste into the Decoder to verify this token
          </label>
          <textarea
            id="encPubKey"
            class={CLS.field + ' min-h-[96px]'}
            readonly
            spellcheck="false"
            placeholder="Generate a key pair to fill this in"></textarea>
          <div class={CLS.genrow}>
            <button class={`${CLS.btnGhost} ${CLS.btnSm}`} id="btnCopyPub">Copy public key</button>
          </div>
        </div>
      </div>
    </div>
    <div class="mt-3.5 flex flex-wrap items-center gap-2">
      <button class={CLS.btn} id="btnSign">Sign &amp; Encode</button>
      <button class={CLS.btnGhost} id="btnVerifyOwn">Verify this key signs the token</button>
      <button class={CLS.btnGhost} id="btnSendDecode">Send to Decoder →</button>
    </div>
    <div id="encMsg"></div>
  </div>

  <div class={CLS.card}>
    <div class={CLS.paneHeadPlain}>
      <label class={CLS.fieldLabelInline} for="encOut">Encoded Token</label>
      <div class={CLS.spacer}></div>
      <button class={`${CLS.btnGhost} ${CLS.btnSm}`} id="btnCopyOut">Copy</button>
    </div>
    <div id="encOut" class={CLS.outToken}>—</div>
  </div>
</section>
