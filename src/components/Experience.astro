---
import Section from './Section.astro';
import { experience } from '../data/resume';

const COLLAPSED = 3;
---

<Section id="experience" title="Experience">
  <div class="space-y-8">
    {
      experience.map((role) => {
        const visible = role.points.slice(0, COLLAPSED);
        const hidden = role.points.slice(COLLAPSED);
        return (
          <article>
            <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
              <h3 class="text-base font-medium text-ink">
                {role.title}
                {role.current && (
                  <span class="ml-2 inline-flex items-center gap-1.5 font-sans text-sm font-normal text-accent">
                    <span aria-hidden="true" class="pulse-dot" />
                    present
                  </span>
                )}
              </h3>
              <p class="text-sm tabular-nums text-mute">{role.period}</p>
            </div>
            <p class="text-sm text-mute">
              {role.company}, {role.place}
            </p>

            <ul class="mt-3 space-y-2 text-[15px]">
              {visible.map((p) => (
                <li class="flex gap-3">
                  <span aria-hidden="true" class="text-mute">–</span>
                  <span>{p}</span>
                </li>
              ))}
            </ul>

            {hidden.length > 0 && (
              <details class="group mt-2">
                <summary class="cursor-pointer list-none text-sm text-accent transition-colors hover:text-ink [&::-webkit-details-marker]:hidden">
                  <span class="group-open:hidden">Show {hidden.length} more</span>
                  <span class="hidden group-open:inline">Show less</span>
                </summary>
                <ul class="mt-3 space-y-2 text-[15px]">
                  {hidden.map((p) => (
                    <li class="flex gap-3">
                      <span aria-hidden="true" class="text-mute">–</span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              </details>
            )}
          </article>
        );
      })
    }
  </div>
</Section>
