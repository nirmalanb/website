---
const NAV = [
  { href: '#about', label: 'About' },
  { href: '#experience', label: 'Experience' },
  { href: '#skills', label: 'Skills' },
  { href: '/guides/', label: 'Guides' },
  { href: '/tools/jwt-decoder/', label: 'JWT tool' },
  { href: '#contact', label: 'Contact' },
];

// Anchor links only resolve on the home page; from guide pages, point back at /.
const base = Astro.url.pathname === '/' ? '' : '/';
const href = (h: string) => (h.startsWith('#') ? `${base}${h}` : h);
---

<header class="border-b border-rule bg-paper sm:sticky sm:top-0 sm:z-40">
  <div
    class="mx-auto flex max-w-2xl flex-wrap items-center justify-between gap-x-6 gap-y-2 px-6 py-4"
  >
    <a href="/" class="flex items-center gap-2.5 text-ink">
      <span class="grid h-7 w-7 place-items-center rounded-lg bg-ink font-display text-xs text-mint">
        NB
      </span>
      <span class="font-display text-base">Nirmala NB</span>
    </a>
    <nav aria-label="Primary" class="flex flex-wrap gap-x-5 gap-y-1 text-sm text-mute">
      {
        NAV.map((item) => (
          <a href={href(item.href)} class="transition-colors hover:text-ink">
            {item.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>