---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="Page not found — Nirmala NB" noindex>
  <Header />
  <main id="main-content" class="mx-auto max-w-2xl px-6 py-28">
    <h1 class="text-3xl text-ink sm:text-4xl">Page not found</h1>
    <p class="mt-4 max-w-prose text-[15px] text-mute">
      You found something that shouldn't be there. Finding those is my job; this one's just a
      missing page.
    </p>
    <p class="mt-6 text-sm">
      <a href="/" class="link">Back to the home page</a>
    </p>
  </main>
</Layout>