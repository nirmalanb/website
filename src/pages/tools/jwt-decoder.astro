---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import JwtDecoder from '../../components/tools/JwtDecoder.astro';
import JwtEncoder from '../../components/tools/JwtEncoder.astro';
import { CLS } from '../../scripts/jwt/jwt-ui.ts';
---

<Layout
  title="JWT Debugger — Nirmala NB"
  description="Decode, verify and generate JSON Web Tokens (RFC 7519) entirely in your browser with the Web Crypto API."
>
  <Header />
  <main id="main-content" data-tool-mount>
    <div class="mx-auto max-w-2xl px-6 pb-12 pt-12 sm:pt-14">
      <header>
        <p class="m-0 text-[0.8125rem] uppercase tracking-[0.08em] text-mute">Tool</p>
        <h1 class="mt-1 text-3xl text-ink sm:text-4xl">JWT debugger</h1>
        <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-mute">
          Decode, inspect and verify a JSON Web Token (<a
            href="https://www.rfc-editor.org/rfc/rfc7519"
            target="_blank"
            rel="noopener noreferrer"
            class="link">RFC 7519</a
          >), or sign a new one. Everything runs in the browser with the Web Crypto API — no
          token ever leaves the page.
        </p>
      </header>

      <nav id="toolTabs" class={CLS.tabNav} role="tablist" aria-label="JWT debugger mode">
        <button
          id="tabDecode"
          class={CLS.tab}
          role="tab"
          aria-selected="true"
          aria-controls="viewDecode"
          tabindex="0"
        >
          Decoder
        </button>
        <button
          id="tabEncode"
          class={CLS.tab}
          role="tab"
          aria-selected="false"
          aria-controls="viewEncode"
          tabindex="-1"
        >
          Encoder
        </button>
      </nav>

      <JwtDecoder />
      <JwtEncoder />

      <p class="rule mt-8 pt-6 text-[13px] leading-relaxed text-mute">
        An educational clone of <a
          href="https://www.jwt.io"
          target="_blank"
          rel="noopener noreferrer"
          class="link">jwt.io</a
        >’s JWT debugger. Tokens are decoded, verified and signed locally with the Web Crypto API —
        nothing is transmitted. Not affiliated with Auth0.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import '../../scripts/jwt/jwt-tool.ts';
</script>
