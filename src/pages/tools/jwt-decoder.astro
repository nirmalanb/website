---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="JWT Debugger — Nirmala NB"
  description="Decode, verify and generate JSON Web Tokens (RFC 7519) entirely in your browser with the Web Crypto API."
>
  <Header />
  <main id="main-content" data-tool-mount class="jwt-tool">
    <div class="mx-auto max-w-2xl px-6 pb-12 pt-12 sm:pt-14">
      <header>
        <p
          class="m-0 text-[0.8125rem] uppercase tracking-[0.08em] text-mute"
        >
          Tool
        </p>
        <h1 class="mt-1 text-3xl text-ink sm:text-4xl">JWT debugger</h1>
        <p class="mt-3 max-w-[60ch] text-[15px] leading-relaxed text-mute">
          Decode, inspect and verify a JSON Web Token (<a
            href="https://www.rfc-editor.org/rfc/rfc7519"
            target="_blank"
            rel="noopener noreferrer">RFC 7519</a
          >), or sign a new one. Everything runs in the browser with the Web Crypto API — no
          token ever leaves the page.
        </p>
      </header>

      <nav class="jwt-tabs" role="tablist" aria-label="JWT debugger mode">
        <button id="tabDecode" class="active" role="tab" aria-selected="true" aria-controls="viewDecode">
          Decoder
        </button>
        <button id="tabEncode" role="tab" aria-selected="false" aria-controls="viewEncode">
          Encoder
        </button>
      </nav>

      <!-- ============================ DECODER ============================ -->
      <section id="viewDecode" role="tabpanel" aria-labelledby="tabDecode">
        <div class="card">
          <div class="toolbar">
            <p class="hint m-0" style="margin:0">
              Paste a JWT below to decode, validate and verify it.
            </p>
            <div class="spacer"></div>
            <button class="btn ghost sm" id="btnExample">Generate example</button>
            <button class="btn ghost sm" id="btnClearToken">Clear</button>
          </div>

          <label class="fl" for="tokInput">Encoded Token</label>
          <div class="tokwrap">
            <pre id="tokBack" class="toklayer" aria-hidden="true"></pre>
            <textarea
              id="tokInput"
              class="toklayer"
              spellcheck="false"
              autocomplete="off"
              aria-describedby="statusRow"
              placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dozjgNryP4J3jVmNHl0w5N_XgL0n3I9PlFUP0THsR8U"></textarea>
          </div>

          <div class="status" style="margin-top:12px" id="statusRow"></div>
        </div>

        <div class="card">
          <div class="pane">
            <div class="phead">
              <span class="t">Decoded Header</span>
              <div class="segtab" data-pane="header">
                <button class="active" data-view="json">JSON</button>
                <button data-view="claims">Claims Breakdown</button>
              </div>
            </div>
            <div id="headerBody">
              <div class="empty">Paste a token above to see the decoded header.</div>
            </div>
          </div>
        </div>

        <div class="card">
          <div class="pane">
            <div class="phead">
              <span class="t">Decoded Payload</span>
              <div class="segtab" data-pane="payload">
                <button class="active" data-view="json">JSON</button>
                <button data-view="claims">Claims Breakdown</button>
              </div>
            </div>
            <div id="payloadBody">
              <div class="empty">Paste a token above to see the decoded payload.</div>
            </div>
          </div>
        </div>

        <div class="card sigbox" style="margin-top:0">
          <h2 class="card-h">
            JWT Signature Verification
            <span class="opt">(Optional)</span>
          </h2>
          <p class="hint">
            Enter the secret used to sign the JWT. For RS* / PS* / ES* algorithms paste a PEM
            public key.
          </p>
          <label class="fl" id="secretLabel" for="secretInput">Secret</label>
          <div class="row" style="align-items:flex-start">
            <div style="flex:2 1 380px">
              <textarea
                id="secretInput"
                spellcheck="false"
                autocomplete="off"
                style="min-height:78px"
                placeholder="a-string-secret-at-least-256-bits-long">a-string-secret-at-least-256-bits-long</textarea>
              <div class="genrow"><span class="kv" id="secretState"></span></div>
            </div>
            <div style="flex:0 1 240px">
              <button class="btn ghost sm" id="btnExampleSecret">Use example secret</button>
              <button class="btn ghost sm" id="btnClearSecret">Clear</button>
            </div>
          </div>
        </div>
      </section>

      <!-- ============================ ENCODER ============================ -->
      <section id="viewEncode" class="hidden" role="tabpanel" aria-labelledby="tabEncode">
        <div class="card">
          <div class="toolbar">
            <p class="hint m-0" style="margin:0">
              Fill in a header and payload, choose an algorithm and key, then sign.
            </p>
            <div class="spacer"></div>
            <button class="btn ghost sm" id="btnEncExample">Load example</button>
          </div>
          <div class="row">
            <div>
              <label class="fl" for="encHeader">Header: Algorithm &amp; Token Type</label>
              <textarea id="encHeader" spellcheck="false">{
  "alg": "HS256",
  "typ": "JWT"
}</textarea>
            </div>
            <div>
              <label class="fl" for="encPayload">Payload: Data</label>
              <textarea id="encPayload" spellcheck="false">{
  "sub": "1234567890",
  "name": "John Doe",
  "admin": true,
  "iat": 1516239022
}</textarea>
            </div>
          </div>
        </div>

        <div class="card">
          <h2 class="card-h">Signing Key</h2>
          <div class="row" style="align-items:flex-start">
            <div style="flex:0 1 200px;min-width:180px">
              <label class="fl" for="encAlg">Algorithm</label>
              <select id="encAlg">
                <optgroup label="HMAC (secret)">
                  <option value="HS256" selected>HS256</option>
                  <option value="HS384">HS384</option>
                  <option value="HS512">HS512</option>
                </optgroup>
                <optgroup label="RSA (PEM key)">
                  <option value="RS256">RS256</option>
                  <option value="RS384">RS384</option>
                  <option value="RS512">RS512</option>
                  <option value="PS256">PS256</option>
                  <option value="PS384">PS384</option>
                  <option value="PS512">PS512</option>
                </optgroup>
                <optgroup label="ECDSA (PEM key)">
                  <option value="ES256">ES256</option>
                  <option value="ES384">ES384</option>
                  <option value="ES512">ES512</option>
                </optgroup>
              </select>
            </div>
            <div style="flex:3 1 420px">
              <label class="fl" id="encKeyLabel" for="encKey">Secret (base64url or raw text)</label>
              <textarea id="encKey" spellcheck="false" style="min-height:110px"
                >a-string-secret-at-least-256-bits-long</textarea>
              <div class="genrow">
                <button class="btn ghost sm hidden" id="btnGenKeys">Generate RSA / EC key pair</button>
                <span class="kv" id="encKeyState" style="margin-left:auto"></span>
              </div>
              <div id="pubKeyWrap" class="hidden" style="margin-top:12px">
                <label class="fl" for="encPubKey"
                  >Public Key (PEM) — paste into the Decoder to verify this token</label>
                <textarea
                  id="encPubKey"
                  readonly
                  spellcheck="false"
                  style="min-height:96px"
                  placeholder="Generate a key pair to fill this in"></textarea>
                <div class="genrow">
                  <button class="btn ghost sm" id="btnCopyPub">Copy public key</button>
                </div>
              </div>
            </div>
          </div>
          <div class="genrow" style="margin-top:14px">
            <button class="btn" id="btnSign">Sign &amp; Encode</button>
            <button class="btn ghost" id="btnVerifyOwn">Verify this key signs the token</button>
            <button class="btn ghost" id="btnSendDecode">Send to Decoder →</button>
          </div>
          <div id="encMsg"></div>
        </div>

        <div class="card">
          <div class="phead outhead">
            <label class="fl m-0" for="encOut">Encoded Token</label>
            <div class="spacer"></div>
            <button class="btn ghost sm" id="btnCopyOut">Copy</button>
          </div>
          <div id="encOut" class="out-token">—</div>
        </div>
      </section>

      <p class="rule mt-8 pt-6 text-[13px] leading-relaxed text-mute">
        An educational clone of
        <a href="https://www.jwt.io" target="_blank" rel="noopener noreferrer">jwt.io</a>’s JWT
        debugger. Tokens are decoded, verified and signed locally with the Web Crypto API —
        nothing is transmitted. Not affiliated with Auth0.
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<style is:global>
  /* JWT tool — deliberately its own surface. Keeps jwt.io's red/violet/blue segment
     coding (a functional affordance, not decoration) on the site's paper/ink palette.
     Global because the badges, claims table and token spans are injected via innerHTML
     at runtime and would never match Astro's scoped selectors. */
  .jwt-tool {
    --jwt-surface: #ffffff;
    --jwt-panel: #f6f9f9;
    --jwt-line: #dbe7e7;
    --jwt-line-soft: #e7f0ef;
    --jwt-txt: #1c2524;
    --jwt-ink: #004747;
    --jwt-muted: #52706d;
    --jwt-dim: #6b8480;
    --jwt-accent: #007a54;
    --jwt-accent-2: #00694a;
    --jwt-ok: #00694a;
    --jwt-warn: #9a5b00;
    --jwt-bad: #b3261e;
    --jwt-seg-header: #b3261e;
    --jwt-seg-payload: #6d28d9;
    --jwt-seg-sig: #0b6ea8;
    --jwt-radius: 10px;
    --jwt-mono: ui-monospace, 'SF Mono', SFMono-Regular, Menlo, monospace;
  }

  .jwt-tool a {
    color: var(--jwt-accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--jwt-accent) 30%, transparent);
    text-underline-offset: 3px;
    transition:
      color 0.15s ease,
      text-decoration-color 0.15s ease;
  }

  .jwt-tool a:hover {
    color: var(--jwt-ink);
    text-decoration-color: currentColor;
  }

  .jwt-tabs {
    display: inline-flex;
    gap: 2px;
    margin: 1.75rem 0 1.25rem;
    padding: 3px;
    border: 1px solid var(--jwt-line);
    border-radius: 999px;
    background: var(--jwt-panel);
  }

  .jwt-tabs button {
    background: transparent;
    border: 0;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    color: var(--jwt-muted);
    padding: 8px 20px;
    border-radius: 999px;
    cursor: pointer;
  }

  .jwt-tabs button.active {
    background: var(--jwt-ink);
    color: #ffffff;
  }

  .jwt-tool .card {
    background: var(--jwt-surface);
    border: 1px solid var(--jwt-line-soft);
    border-radius: 14px;
    padding: 18px;
    margin-bottom: 18px;
    box-shadow: 0 1px 2px rgba(0, 71, 71, 0.04);
  }

  .jwt-tool .card-h {
    margin: 0 0 12px;
    font-size: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--jwt-muted);
  }

  .jwt-tool .card-h .opt {
    text-transform: none;
    letter-spacing: 0;
    font-weight: 400;
    color: var(--jwt-dim);
  }

  .jwt-tool .hint {
    color: var(--jwt-dim);
    font-size: 13px;
    margin: -4px 0 12px;
  }

  .jwt-tool .row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .jwt-tool .row > * {
    flex: 1 1 0;
    min-width: 260px;
  }

  .jwt-tool label.fl {
    display: block;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--jwt-muted);
    margin: 0 0 6px;
  }

  .jwt-tool .mono {
    font-family: var(--jwt-mono);
  }

  .jwt-tool input[type='text'],
  .jwt-tool input[type='password'],
  .jwt-tool select,
  .jwt-tool textarea {
    width: 100%;
    background: var(--jwt-panel);
    color: var(--jwt-txt);
    border: 1px solid var(--jwt-line);
    border-radius: var(--jwt-radius);
    padding: 10px 12px;
    font-family: var(--jwt-mono);
    font-size: 13px;
    line-height: 1.6;
    outline: none;
  }

  .jwt-tool input:focus,
  .jwt-tool select:focus,
  .jwt-tool textarea:focus {
    border-color: var(--jwt-accent);
    box-shadow: 0 0 0 3px rgba(0, 122, 84, 0.15);
  }

  .jwt-tool select {
    font-family: inherit;
    font-size: 14px;
  }

  .jwt-tool textarea {
    resize: vertical;
    min-height: 150px;
    tab-size: 2;
  }

  .jwt-tool ::placeholder {
    color: var(--jwt-dim);
  }

  .jwt-tool .btn {
    background: var(--jwt-accent);
    color: #ffffff;
    border: 0;
    border-radius: var(--jwt-radius);
    padding: 10px 16px;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color 0.15s ease;
  }

  .jwt-tool .btn:hover {
    background: var(--jwt-accent-2);
  }

  .jwt-tool .btn.ghost {
    background: transparent;
    border: 1px solid var(--jwt-line);
    color: var(--jwt-ink);
  }

  .jwt-tool .btn.ghost:hover {
    background: color-mix(in oklab, var(--jwt-line) 45%, var(--jwt-surface));
  }

  .jwt-tool .btn.sm {
    padding: 6px 11px;
    font-size: 12px;
    font-weight: 600;
  }

  .jwt-tool .toolbar {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .jwt-tool .toolbar .spacer,
  .jwt-tool .phead .spacer {
    flex: 1;
  }

  /* ---- token highlight overlay ---- */
  .jwt-tool .tokwrap {
    position: relative;
    border: 1px solid var(--jwt-line);
    border-radius: var(--jwt-radius);
    background: var(--jwt-panel);
    overflow: hidden;
  }

  /* The overlay (pre) and the editable textarea share .toklayer, so font-size,
     line-height and padding must stay identical or the colours walk off the caret. */
  .jwt-tool .toklayer {
    margin: 0;
    font-family: var(--jwt-mono);
    font-size: 13.5px;
    line-height: 1.7;
    padding: 12px 14px;
    white-space: pre-wrap;
    word-break: break-all;
    overflow-wrap: anywhere;
  }

  .jwt-tool #tokBack {
    position: absolute;
    inset: 0;
    pointer-events: none;
    color: transparent;
    overflow: auto;
  }

  .jwt-tool #tokBack .h {
    color: var(--jwt-seg-header);
  }

  .jwt-tool #tokBack .p {
    color: var(--jwt-seg-payload);
  }

  .jwt-tool #tokBack .s {
    color: var(--jwt-seg-sig);
  }

  .jwt-tool #tokBack .dot,
  .jwt-tool .out-token .dot {
    color: var(--jwt-dim);
    font-weight: 700;
  }

  .jwt-tool #tokInput {
    position: relative;
    display: block;
    background: transparent;
    border: 0;
    border-radius: 0;
    color: transparent;
    caret-color: var(--jwt-txt);
    min-height: 88px;
    height: 88px;
    resize: vertical;
  }

  .jwt-tool #tokInput::selection {
    background: rgba(0, 122, 84, 0.28);
  }

  .jwt-tool #tokInput:focus {
    box-shadow: none;
    border: 0;
  }

  .jwt-tool #tokInput::placeholder {
    color: var(--jwt-dim);
  }

  /* panes */
  .jwt-tool .pane {
    background: var(--jwt-panel);
    border: 1px solid var(--jwt-line);
    border-radius: var(--jwt-radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .jwt-tool .pane .phead {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 10px;
    border-bottom: 1px solid var(--jwt-line-soft);
    background: color-mix(in oklab, var(--jwt-line) 30%, var(--jwt-surface));
  }

  .jwt-tool .pane .phead .t {
    font-weight: 700;
    font-size: 13px;
    letter-spacing: 0.02em;
  }

  .jwt-tool .phead.outhead {
    padding: 0 0 10px;
    border: 0;
    background: none;
  }

  .jwt-tool .segtab {
    display: flex;
    gap: 2px;
    background: var(--jwt-surface);
    border: 1px solid var(--jwt-line-soft);
    border-radius: 8px;
    padding: 2px;
    margin-left: auto;
  }

  .jwt-tool .segtab button {
    background: transparent;
    border: 0;
    color: var(--jwt-muted);
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 6px;
    cursor: pointer;
  }

  .jwt-tool .segtab button.active {
    background: var(--jwt-ink);
    color: #ffffff;
  }

  .jwt-tool .pane pre {
    margin: 0;
    padding: 12px 14px;
    font-family: var(--jwt-mono);
    font-size: 13px;
    line-height: 1.65;
    overflow: auto;
    max-height: 340px;
    white-space: pre-wrap;
    word-break: break-word;
    background: transparent;
    color: var(--jwt-txt);
    border-radius: 0;
  }

  .jwt-tool .pane .empty {
    padding: 20px 14px;
    color: var(--jwt-dim);
    font-size: 13px;
  }

  .jwt-tool table.claims {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .jwt-tool table.claims th {
    text-align: left;
    color: var(--jwt-muted);
    font-weight: 600;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 8px 14px;
    border-bottom: 1px solid var(--jwt-line-soft);
  }

  .jwt-tool table.claims td {
    padding: 8px 14px;
    border-bottom: 1px solid var(--jwt-line-soft);
    vertical-align: top;
    word-break: break-word;
  }

  .jwt-tool table.claims td.k {
    font-family: var(--jwt-mono);
    color: var(--jwt-seg-payload);
    white-space: nowrap;
  }

  .jwt-tool table.claims td.v {
    font-family: var(--jwt-mono);
  }

  .jwt-tool table.claims td.d {
    color: var(--jwt-muted);
  }

  .jwt-tool .claimwrap {
    max-height: 340px;
    overflow: auto;
  }

  .jwt-tool .status {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    align-items: center;
  }

  .jwt-tool .badge {
    font-size: 12.5px;
    font-weight: 700;
    border-radius: 999px;
    padding: 5px 12px;
    border: 1px solid transparent;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .jwt-tool .badge .dotm {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }

  .jwt-tool .badge.ok {
    color: var(--jwt-ok);
    background: color-mix(in oklab, var(--jwt-ok) 10%, var(--jwt-surface));
    border-color: color-mix(in oklab, var(--jwt-ok) 35%, transparent);
  }

  .jwt-tool .badge.bad {
    color: var(--jwt-bad);
    background: color-mix(in oklab, var(--jwt-bad) 10%, var(--jwt-surface));
    border-color: color-mix(in oklab, var(--jwt-bad) 35%, transparent);
  }

  .jwt-tool .badge.warn {
    color: var(--jwt-warn);
    background: color-mix(in oklab, var(--jwt-warn) 10%, var(--jwt-surface));
    border-color: color-mix(in oklab, var(--jwt-warn) 35%, transparent);
  }

  .jwt-tool .badge.neutral {
    color: var(--jwt-muted);
    background: var(--jwt-panel);
    border-color: var(--jwt-line);
  }

  .jwt-tool .kv {
    font-size: 13px;
    color: var(--jwt-muted);
  }

  .jwt-tool .kv b {
    color: var(--jwt-txt);
    font-weight: 600;
  }

  .jwt-tool .sigbox {
    margin-top: 18px;
  }

  .jwt-tool .out-token {
    background: var(--jwt-panel);
    border: 1px solid var(--jwt-line);
    border-radius: var(--jwt-radius);
    padding: 12px 14px;
    font-family: var(--jwt-mono);
    font-size: 13px;
    word-break: break-all;
    line-height: 1.7;
    max-height: 240px;
    overflow: auto;
    white-space: pre-wrap;
  }

  .jwt-tool .out-token .h {
    color: var(--jwt-seg-header);
  }

  .jwt-tool .out-token .p {
    color: var(--jwt-seg-payload);
  }

  .jwt-tool .out-token .s {
    color: var(--jwt-seg-sig);
  }

  .jwt-tool .err {
    color: var(--jwt-bad);
    font-size: 13px;
    margin-top: 8px;
    white-space: pre-wrap;
  }

  .jwt-tool .okmsg {
    color: var(--jwt-ok);
    font-size: 13px;
    margin-top: 8px;
  }

  .jwt-tool .hidden {
    display: none !important;
  }

  .jwt-tool .genrow {
    display: flex;
    gap: 8px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 8px;
  }

  @media (max-width: 640px) {
    .jwt-tabs {
      display: flex;
    }

    .jwt-tabs button {
      flex: 1;
    }
  }
</style>

<script>
  import '../../scripts/jwt-decoder.js';
</script>
