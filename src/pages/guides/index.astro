---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);

// Search is built and working; hidden for now. Flip to true to show the box.
const SEARCH_ENABLED = false;
---

<Layout title="Guides — Nirmala NB">
  <Header />
  <main id="main-content">
    <section class="mx-auto max-w-2xl px-6 pb-12 pt-12 sm:pt-14">
      <h1 class="text-3xl text-ink sm:text-4xl">Guides</h1>
      <p class="mt-3 max-w-prose text-[15px] leading-relaxed">
        <span class="font-medium text-ink"
          >Security explainers I kept repeating out loud, so I wrote them down.</span
        >
        More whenever the OSCP syllabus throws something new at me.
      </p>

      <p class="mt-4 max-w-prose text-sm text-mute">
        Working with a token right now? The <a href="/tools/jwt-decoder/" class="link">JWT debugger</a>
        decodes, verifies and signs one locally — no token leaves the browser.
      </p>

      {SEARCH_ENABLED && <div class="mt-7 empty:hidden" data-search-mount></div>}

      <ol class="mt-9">
        {
          guides.map((guide, i) => {
            const words = (guide.body ?? '').split(/\s+/).filter(Boolean).length;
            const minutes = Math.max(1, Math.round(words / 200));
            return (
              <li class="rule pt-7 pb-7 last:pb-0" data-guide-id={guide.id}>
                <div class="grid grid-cols-[2.5rem_1fr] gap-x-4">
                  <span
                    aria-hidden="true"
                    class="font-display text-base text-accent tabular-nums sm:pt-0.5"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <div>
                    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-0.5">
                      <h2 class="text-base font-medium">
                        <a
                          href={`/guides/${guide.id}/`}
                          class="text-ink transition-colors hover:text-accent"
                        >
                          {guide.data.title}
                        </a>
                      </h2>
                      <p class="text-sm tabular-nums text-mute">
                        <time datetime={guide.data.publishDate.toISOString()}>
                          {guide.data.publishDate.toLocaleDateString('en-GB', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                          })}
                        </time>
                        {' · '}
                        {minutes} min
                      </p>
                    </div>
                    <p class="mt-1.5 max-w-prose text-[15px] text-body">{guide.data.excerpt}</p>
                    {guide.data.tags.length > 0 && (
                      <p class="mt-1.5 text-sm text-mute">{guide.data.tags.join(' · ')}</p>
                    )}
                  </div>
                </div>
              </li>
            );
          })
        }
      </ol>
    </section>
  </main>
  <Footer />
</Layout>

{
  SEARCH_ENABLED && (
    <script>
      import '../../scripts/search';
    </script>
  )
}